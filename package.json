{
  "name": "moxymind-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI and REST API tests for the Moxymind technical task",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:demo-fail": "set DEMO_FAIL=1&& playwright test tests/api/04-api.spec.ts -g \"DEMO:\"",
    "test:api:full-log": "set LOG_FULL_RESPONSE=1&& playwright test tests/api",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "saucedemo",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2"
  }
}
